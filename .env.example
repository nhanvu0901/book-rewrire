# Copy to .env and fill in every value. .env is gitignored; keep it private.
# OPENROUTER_API_KEY is required for `pov extract`.

# OpenRouter (needed for `pov extract`)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_MAX_TOKENS=

# Where books and extracted output live
BOOK_CLONE_DATA_DIR=

# Neo4j (docker/compose.yml and `pov ingest`). Use ports other than 7474/7687
# if the other book-clone stack is running.
NEO4J_PASSWORD=
NEO4J_USER=
NEO4J_HTTP_PORT=
NEO4J_BOLT_PORT=
# Optional: NEO4J_PLUGINS=["apoc"] enables APOC
NEO4J_PLUGINS=
