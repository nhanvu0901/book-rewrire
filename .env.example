# Names only. Put the real values in ~/.config/book-clone/secrets.env (chmod 600), never in git.
# Phase A needs none of them except DEEPSEEK_API_KEY for the optional `--map llm`.

# DeepSeek (only for `pov extract --map llm`)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Where books and extracted output live (default: ~/.local/share/book-clone)
BOOK_CLONE_DATA_DIR=

# Neo4j (docker/compose.yml and `pov ingest`). The host ports differ from the "book-clone" stack
# (7474/7687) on purpose, so both can run at the same time.
NEO4J_PASSWORD=
NEO4J_USER=
NEO4J_HTTP_PORT=
NEO4J_BOLT_PORT=
# Optional: NEO4J_PLUGINS=["apoc"] enables APOC
NEO4J_PLUGINS=
