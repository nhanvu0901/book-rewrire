# Names only. Put the real values in ~/.config/book-clone/secrets.env (chmod 600), never in git.
# Phase A needs none of them except DEEPSEEK_API_KEY for the optional `--map llm`.

# DeepSeek (only for `pov extract --map llm`)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Where books and extracted output live (default: ~/.local/share/book-clone)
BOOK_CLONE_DATA_DIR=

# Used by docker/compose.yml for the next step (Postgres and Neo4j)
NEO4J_PASSWORD=
POSTGRES_PASSWORD=
POSTGRES_USER=
POSTGRES_DB=
POSTGRES_PORT=
NEO4J_HTTP_PORT=
NEO4J_BOLT_PORT=
