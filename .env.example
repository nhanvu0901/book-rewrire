# Copy to .env and fill in every value. .env is gitignored; keep it private.
# OPENROUTER_API_KEY is required for `pov extract` and `pov ingest`.

# OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
OPENROUTER_MODEL=
OPENROUTER_SUMMARIZE_CHAPTER_MODEL=
# Summary reasoning: none (provider default) | enabled | low | medium | high.
OPENROUTER_SUMMARIZE_CHAPTER_REASONING=
# General LLM for complete character profiles and identity merges.
OPENROUTER_EXTRACT_CHARACTER_MODEL=
# Output-token limits (reasoning tokens count too); each must fit its model's limit.
# OPENROUTER_MAX_TOKENS is for OPENROUTER_MODEL (pov extract) and diagnostics.
OPENROUTER_MAX_TOKENS=
OPENROUTER_SUMMARIZE_CHAPTER_MAX_TOKENS=
OPENROUTER_EXTRACT_CHARACTER_MAX_TOKENS=
# Extract client provider routing, reasoning and structured output options:
# OPENROUTER_EXTRACT_CHARACTER_PROVIDER: comma-separated provider tags (empty = default routing)
# OPENROUTER_EXTRACT_CHARACTER_ALLOW_FALLBACKS: true | false
# OPENROUTER_EXTRACT_CHARACTER_REASONING: none | enabled | low | medium | high
# OPENROUTER_EXTRACT_CHARACTER_STRUCTURED_OUTPUTS: true | false
OPENROUTER_EXTRACT_CHARACTER_PROVIDER=
OPENROUTER_EXTRACT_CHARACTER_ALLOW_FALLBACKS=
OPENROUTER_EXTRACT_CHARACTER_REASONING=
OPENROUTER_EXTRACT_CHARACTER_STRUCTURED_OUTPUTS=

# Where books and extracted output live
BOOK_CLONE_DATA_DIR=

# Neo4j (docker/compose.yml and `pov ingest`). Use ports other than 7474/7687
# if the other book-clone stack is running.
NEO4J_PASSWORD=
NEO4J_USER=
NEO4J_HTTP_PORT=
NEO4J_BOLT_PORT=
# Optional: NEO4J_PLUGINS=["apoc"] enables APOC
NEO4J_PLUGINS=
